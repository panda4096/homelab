# Firefly III 应用层密钥真值源。
# 被 infra/apps/firefly/scripts/apply-secrets.sh 读取。
# 数据库密码在 infra/.secrets/postgresql.env 中的 FIREFLY_DB_PASSWORD。
#
# 私仓信任模型：允许 git 管理，不要公开分享。
# 替换 REPLACE_ME 为真值后再运行 apply-secrets.sh。
#
# APP_KEY 生成：`openssl rand -base64 32`，前缀加 `base64:`

FIREFLY_APP_KEY=base64:REPLACE_ME
FIREFLY_SITE_OWNER=you@example.com
