# Ghostfolio 应用层密钥真值源。
# 被 infra/apps/ghostfolio/scripts/apply-secrets.sh 读取。
# 数据库密码在 infra/.secrets/postgresql.env 中的 GHOSTFOLIO_DB_PASSWORD。
#
# 私仓信任模型：允许 git 管理，不要公开分享。
# 替换 REPLACE_ME 为真值后再运行 apply-secrets.sh。
#
# ACCESS_TOKEN_SALT / JWT_SECRET_KEY 建议：`openssl rand -hex 32`

GHOSTFOLIO_ACCESS_TOKEN_SALT=REPLACE_ME
GHOSTFOLIO_JWT_SECRET_KEY=REPLACE_ME
GHOSTFOLIO_REDIS_PASSWORD=REPLACE_ME
