# Ghostfolio 应用层密钥真值源。
# 被 infra/apps/ghostfolio/scripts/apply-secrets.sh 读取。
# 数据库密码在 infra/.secrets/postgresql.env 中的 GHOSTFOLIO_DB_PASSWORD。
#
# 私仓信任模型：允许 git 管理，不要公开分享。

GHOSTFOLIO_ACCESS_TOKEN_SALT=1f2567c9ca53b98591fc6fa897f8c7415c7e9a3af59bbed5622cc3f0a93dc2dd
GHOSTFOLIO_JWT_SECRET_KEY=a48f0b5fd0e06c9be4f50ff30507b202408c3c1a42f01a18faf63ecab86513f8
GHOSTFOLIO_OIDC_CLIENT_SECRET=4b5ba3c57d5c6f6d1dd0c839c3191692b14d4e289ac28be1092cdad599178fd7
GHOSTFOLIO_REDIS_PASSWORD=2fd912b73bbdcc2afdeb1c112412a028
#
# 可选：让 Ghostfolio 的外网行情请求走新加坡 egress。
# 内部流量（PostgreSQL / Redis / cluster service）通过 NO_PROXY 直连，不走外部代理。
GHOSTFOLIO_HTTP_PROXY=http://edge-user:ZGMSVYKJIdT48RtsAAGa@10.4.0.2:11081
GHOSTFOLIO_HTTPS_PROXY=http://edge-user:ZGMSVYKJIdT48RtsAAGa@10.4.0.2:11081
GHOSTFOLIO_NO_PROXY=127.0.0.1,localhost,ghostfolio-redis,postgresql.data.svc.cluster.local,.svc,.cluster.local,kubernetes.default.svc
GHOSTFOLIO_NODE_USE_ENV_PROXY=1
