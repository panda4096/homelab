# 共享数据层 PostgreSQL 密码真值源。
# 被以下脚本 source：
#   - infra/data/postgresql/scripts/apply-secrets.sh  （生成 postgresql-admin / postgresql-init-scripts）
#   - infra/apps/firefly/scripts/apply-secrets.sh     （组装 firefly 的 DB_PASSWORD）
#   - infra/apps/ghostfolio/scripts/apply-secrets.sh  （组装 DATABASE_URL）
#   - infra/apps/finbrain/scripts/apply-secrets.sh    （组装 FINBRAIN_DATABASE_URL）
#
# 私仓信任模型：本文件允许 git 管理，但不要公开分享。
# 替换 REPLACE_ME 为真值后再运行上述任何脚本。

POSTGRES_ADMIN_PASSWORD=REPLACE_ME
FIREFLY_DB_PASSWORD=REPLACE_ME
GHOSTFOLIO_DB_PASSWORD=REPLACE_ME
FINBRAIN_DB_PASSWORD=REPLACE_ME
