# finbrain ingest-agent 非数据库密钥真值源。
# 被 infra/apps/finbrain/scripts/apply-secrets.sh 读取。
# 数据库密码在 infra/.secrets/postgresql.env 中的 FINBRAIN_DB_PASSWORD。
#
# 私仓信任模型：允许 git 管理，不要公开分享。
# Firefly / Ghostfolio 的 API token 需要在各自应用初始化后手工获取并回填。

FINBRAIN_FIREFLY_TOKEN=placeholder-fill-after-firefly-init
FINBRAIN_GHOSTFOLIO_TOKEN=placeholder-fill-after-ghostfolio-init
