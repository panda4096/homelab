{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 10,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"expr": "max(kilo_nodes)", "instant": true, "refId": "A"}],
      "title": "Kilo Mesh Nodes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"expr": "sum(increase(kilo_errors_total[10m]))", "instant": true, "refId": "A"}],
      "title": "Kilo Errors (10m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "time() - wireguard_latest_handshake_seconds{interface=~\"$interface\",node=~\"$node\"}", "legendFormat": "{{node}} / {{public_key}}", "refId": "A"}],
      "title": "WireGuard Handshake Age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(wireguard_received_bytes_total{interface=~\"$interface\",node=~\"$node\"}[5m])", "legendFormat": "rx {{node}} / {{public_key}}", "refId": "A"},
        {"expr": "rate(wireguard_sent_bytes_total{interface=~\"$interface\",node=~\"$node\"}[5m])", "legendFormat": "tx {{node}} / {{public_key}}", "refId": "B"}
      ],
      "title": "WireGuard Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[5m])", "legendFormat": "rx {{instance}} / {{device}}", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[5m])", "legendFormat": "tx {{instance}} / {{device}}", "refId": "B"}
      ],
      "title": "Node Interface Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 4,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"expr": "100 * (node_nf_conntrack_entries{cluster=~\"$cluster\",instance=~\"$node\"} / node_nf_conntrack_entries_limit{cluster=~\"$cluster\",instance=~\"$node\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Conntrack Usage",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(kilo_reconciles_total[5m])", "legendFormat": "reconciles {{instance}}", "refId": "A"},
        {"expr": "rate(kilo_iptables_operations_total[5m])", "legendFormat": "iptables {{instance}} / {{operation}} / {{table}}", "refId": "B"}
      ],
      "title": "Kilo Reconcile & iptables Activity",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["infra", "managed-by-repo", "network", "wireguard"],
  "templating": {
    "list": [
      {"current": {"selected": true, "text": "VictoriaMetrics", "value": "VictoriaMetrics"}, "hide": 0, "includeAll": false, "label": "datasource", "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"},
      {"current": {"selected": true, "text": "homelab-k3s", "value": "homelab-k3s"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(node_uname_info, cluster)", "includeAll": true, "label": "cluster", "multi": false, "name": "cluster", "query": {"query": "label_values(node_uname_info, cluster)", "refId": "Cluster"}, "refresh": 2, "type": "query"},
      {"current": {"selected": true, "text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)", "includeAll": true, "label": "node", "multi": true, "name": "node", "query": {"query": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)", "refId": "Node"}, "refresh": 2, "type": "query"},
      {"current": {"selected": true, "text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(wireguard_latest_handshake_seconds, interface)", "includeAll": true, "label": "interface", "multi": true, "name": "interface", "query": {"query": "label_values(wireguard_latest_handshake_seconds, interface)", "refId": "Interface"}, "refresh": 2, "type": "query"},
      {"current": {"selected": true, "text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(node_network_receive_bytes_total{cluster=~\"$cluster\"}, device)", "includeAll": true, "label": "device", "multi": true, "name": "device", "query": {"query": "label_values(node_network_receive_bytes_total{cluster=~\"$cluster\"}, device)", "refId": "Device"}, "refresh": 2, "type": "query"}
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "WireGuard & Underlay",
  "uid": "infra-wireguard-underlay",
  "version": 1,
  "weekStart": ""
}
