          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(node_netstat_Tcp_RetransSegs{cluster=~\"$cluster\",instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "TCP Retransmits",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "100 * (node_nf_conntrack_entries{cluster=~\"$cluster\",instance=~\"$node\"} / node_nf_conntrack_entries_limit{cluster=~\"$cluster\",instance=~\"$node\"})",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Conntrack Usage",
      "type": "bargauge"
    }
