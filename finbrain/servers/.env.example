# finbrain backend dev config.
#
# 数据库 = infra 已部署的 NUC dev postgres(192.168.100.29:30432,见
# ../../infra/data/postgresql/nuc-dev/README.md)。不使用本地 docker postgres。
#
# `make migrate|seed|run` 会自动从共享密钥
# (../../infra/.secrets/postgresql.env 里的 FINBRAIN_DB_PASSWORD) 组装
# DATABASE_URL,通常无需在此设置。
#
# 若直接跑二进制 / go run,自行导出:
#   set -a; source ../../infra/.secrets/postgresql.env; set +a
#   export DATABASE_URL="postgres://finbrain:${FINBRAIN_DB_PASSWORD}@192.168.100.29:30432/finbrain?sslmode=disable"
#   export GOTOOLCHAIN=local

FINBRAIN_ENV=development
FINBRAIN_TIMEZONE=Asia/Shanghai
PORT=8000
# FINBRAIN_STATIC_DIR=../webs/dist
